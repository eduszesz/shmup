pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--hex space
--by eduszesz

function _init()
	enemies={}
	mapset()	
	
end

function _update()
	
end

function _draw()
	cls()
	map()
	for e in all(enemies) do
		spr(e.sp,e.x,e.y,1,1,e.flpx,e.flpy)
		line(e.x,e.y,
	end
	
end


function mapset()
	for j=0,12 do
		if j%2==0 then
			for i=0, 15 do
				mset(i,j,1)
			end
		else
			for i=0, 14 do
				mset(i,j,2)
			end	
		end
	end
	for i=1,6 do
		local x=flr(rnd(14)+1)
		local y=flr(rnd(11)+1)
		local j=0
		local rng=4
		local flpx=false
		local flpy=false
		if mget(x,y)==2 then j=4 end
		if rnd()<0.5 then rng=5 end
		if rnd()<0.5 then flpx=true end
		if rnd()>0.5 then flpy=true end
		local e={x=(8*x+j),y=8*y,sp=4,rng=rng,flpx=flpx,flpy=flpy}
		add(enemies,e)
		
	end
end

