pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--hex space
--by eduszesz

function _init()
	t=0
	enemies={}
	mission=3
	mapset()
	p={
				x=8*flr(rnd(14)+1),
				y=12*8,
				sp=3,
				sh=2,
				ms=3}
	
end

function _update()
	t+=1
end

function _draw()
	cls()
	map()
	for e in all(enemies) do
		local dir=1
		if e.flpx then dir=-1 end
		if t%8<4 then
			pal(9,10)
		end
		line(e.x+4,e.y+4,e.x+(e.rng*dir),e.y+4,13)
		spr(e.sp,e.x,e.y,1,1,e.flpx)
		pal()
	end
	
	
	
	spr(p.sp,p.x,p.y)
	if t%8<4 then
		spr(7,p.x,p.y+8)
	else
		spr(8,p.x,p.y+8)
	end
	--hud
	for i=1,3 do
		spr(16,i*8,14*8)
	end
	for i=1,2 do
		spr(15,i*8,15*8)
	end
	print("destroy "..mission.." enemies",40,112,7)  
end


function mapset()
	for j=0,12 do
		if j%2==0 then
			for i=0, 15 do
				mset(i,j,1)
			end
		else
			for i=0, 14 do
				mset(i,j,2)
			end	
		end
	end
	for i=1,6 do
		local x=flr(rnd(14))
		local y=flr(rnd(11))
		local j=0
		local rng=32
		local flpx=false
		local flpy=false
		if mget(x,y)==2 then j=4 end
		if rnd()<0.5 then rng=40 end
		if rnd()<0.5 then flpx=true end
		local e={x=(8*x+j),y=8*y,sp=4,rng=rng,flpx=flpx}
		add(enemies,e)
		
	end
end

