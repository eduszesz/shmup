function _update()
	
end

function _draw()
	cls()
	
	for j=0,15 do
		if j%2==0 then
			for i=0, 15 do
				spr(1,i*8,j*8)
			end
		else
			for i=0, 14 do
				spr(1,4+i*8,8*j)
			end	
		end
	end
end
