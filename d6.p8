pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--d6
--by eduszesz

function _init()
	sp={17,19,21,23,25,27}
	r=17
	t=0
	cl=7
end

function _update()
	if btnp(4) or btnp(5) then
		t=0
	end
	if t<60 then
		t+=1
		if t%2==0 then
			r=rnd(sp)
			cl=rnd(15)
		end
	else
		cl=7
	end
end

function _draw()
	cls()
	spr(r,64-8,64-8,2,2)
	rect(0,0,127,127,cl)
end
