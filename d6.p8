pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--d6
--by eduszesz

function _init()
	sp={1,3,5,7,9,11}
	r=1
	t=60
	cl=7
end

function _update()
	pal()
	if btnp(4) or btnp(5) then
		t=0
	end
	if t<60 then
		t+=1
		if t%8<4 then
			r=rnd(sp)
			pal(2,14)
			pal(14,2)
		end
	end
end

function _draw()
	cls()
	spr(r,64-8,64-8,2,2)
	rect(0,0,127,127,cl)
end
